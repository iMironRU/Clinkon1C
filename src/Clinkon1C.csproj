<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0-windows;net48</TargetFrameworks>
    <AssemblyName>Clinkon1C</AssemblyName>
    <RootNamespace>Clinkon1C</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Version>1.2.43</Version>
    <Company>Clinkon1C</Company>
    <Description>Утилита администратора для очистки артефактов 1С</Description>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Copyright>Copyright © 2025</Copyright>
    <!-- Workstation GC — интерактивная консольная утилита, не сервер. Server GC
         резервирует память под каждое ядро и неохотно отдаёт её ОС обратно,
         из-за чего процесс выглядит "прожорливым" в диспетчере задач даже
         после того как реальные данные (большой скан кэша) уже не нужны. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <!-- .NET 8: self-contained single file -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <!-- .NET Framework 4.8: для Windows 7 -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net48'">
    <SelfContained>false</SelfContained>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.EventLog" Version="8.*" />
  </ItemGroup>

  <!-- System.Management (WMI): для net8 — NuGet, для net48 — в GAC -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0-windows'">
    <PackageReference Include="System.Management" Version="8.*" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\ring.car" LogicalName="ring.car" />
    <EmbeddedResource Include="Resources\license-tools.car" LogicalName="license-tools.car" />
  </ItemGroup>

  <!-- Пакеты только для net48 (в net8 встроены) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <PackageReference Include="System.Text.Json" Version="8.*" />
    <PackageReference Include="System.Net.Http.Json" Version="8.*" />
    <!-- ZipArchive требует отдельной ссылки в net48 -->
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Management" />
    <!-- Встраивает все DLL в exe, чтобы не нужно было раскладывать рядом -->
    <PackageReference Include="Fody" Version="6.*" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <PackageReference Include="Costura.Fody" Version="5.*" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
